# BestTris · configuración para Apache (en nginx se ignora; ver README).

# No servir la carpeta .git ni archivos de desarrollo
RedirectMatch 404 /\.git
RedirectMatch 404 /(tests|tools|node_modules|server)(/|$)
RedirectMatch 404 /(package\.json|README\.md)$

# Tipos correctos para módulos y manifiesto
AddType text/javascript .js
AddType application/manifest+json .webmanifest

# Código y estilos siempre se revalidan (304 si no cambian) para recibir versiones nuevas
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|html|webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
